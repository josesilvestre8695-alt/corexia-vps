# Copie para .env e preencha

# Roboflow (só p/ baixar o modelo — a inferência roda LOCAL na sua GPU, sem custo por frame)
ROBOFLOW_API_KEY=coloque_sua_chave_roboflow

# Modelo do Roboflow Universe (formato projeto/versao).
# RECOMENDADO p/ arma+faca: yolo-weapon-detection (mAP 77.9%, classes handgun/rifle/knife)
# -> confirme o numero da versao na aba "Deploy" do modelo no Roboflow
MODEL_ID=yolo-weapon-detection/1

# Gemini (2º estágio de confirmação — só nos frames suspeitos)
GEMINI_API_KEY=coloque_sua_chave_gemini
GEMINI_MODEL=gemini-2.5-flash
USE_GEMINI_VERIFY=true

# Webhook do Base44 (URL confirmada funcionando em jul/2026)
WEBHOOK_URL=https://base44.app/api/apps/69bdd470af0bb9361c119aa8/functions/webhookAlertas
WEBHOOK_SECRET=corexia-webhook-2024

# Ajustes de detecção
CONF_MIN=0.45
COOLDOWN_SEG=300
MAX_FPS=4
TIPOS_ATIVOS=arma_fogo,arma_branca,fogo
